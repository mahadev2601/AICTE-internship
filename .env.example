# Fitness Buddy - Environment Variables Template
# Copy this file to .env and fill in your real values.
# Never commit the actual .env file to git.

# IBM watsonx.ai API Key
# Get it from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_api_key_here

# watsonx.ai Service URL (region-specific)
# Options:
#   https://us-south.ml.cloud.ibm.com  (Dallas)
#   https://eu-de.ml.cloud.ibm.com     (Frankfurt)
#   https://eu-gb.ml.cloud.ibm.com     (London)
#   https://jp-tok.ml.cloud.ibm.com    (Tokyo)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# watsonx.ai Project ID
# Get it from: https://dataplatform.cloud.ibm.com -> your project -> Manage -> General
WATSONX_PROJECT_ID=your_project_id_here
